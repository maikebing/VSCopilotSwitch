<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VSCopilotSwitch.MewUi</AssemblyName>
    <RootNamespace>VSCopilotSwitch.MewUi</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Windows" Version="0.15.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <ProjectReference Include="..\VSCopilotSwitch.Core\VSCopilotSwitch.Core.csproj" />
    <ProjectReference Include="..\VSCopilotSwitch.VsCodeConfig\VSCopilotSwitch.VsCodeConfig.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\VSCopilotSwitch\OpenAiChatCompletionMapper.cs" Link="SharedHost\OpenAiChatCompletionMapper.cs" />
    <Compile Include="..\VSCopilotSwitch\OpenAiErrorMapper.cs" Link="SharedHost\OpenAiErrorMapper.cs" />
    <Compile Include="..\VSCopilotSwitch\OpenAiModelMapper.cs" Link="SharedHost\OpenAiModelMapper.cs" />
    <Compile Include="..\VSCopilotSwitch\Services\ActiveProviderModelProvider.cs" Link="SharedHost\Services\ActiveProviderModelProvider.cs" />
    <Compile Include="..\VSCopilotSwitch\Services\CopilotCompatibilityProbeService.cs" Link="SharedHost\Services\CopilotCompatibilityProbeService.cs" />
    <Compile Include="..\VSCopilotSwitch\Services\OpenAiCompatibilityPaths.cs" Link="SharedHost\Services\OpenAiCompatibilityPaths.cs" />
    <Compile Include="..\VSCopilotSwitch\Services\ProviderConfigService.cs" Link="SharedHost\Services\ProviderConfigService.cs" />
    <Compile Include="..\VSCopilotSwitch\Services\RequestAnalyticsService.cs" Link="SharedHost\Services\RequestAnalyticsService.cs" />
    <Compile Include="..\VSCopilotSwitch\Services\StartupDiagnostics.cs" Link="SharedHost\Services\StartupDiagnostics.cs" />
    <Compile Include="..\VSCopilotSwitch\Services\UpdateService.cs" Link="SharedHost\Services\UpdateService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\VSCopilotSwitch\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\VSCopilotSwitch\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
